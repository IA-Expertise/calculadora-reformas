# Porta do portal. No Railway o valor vem da plataforma; localmente o padrão é 3000.
PORT=3000

# Origem de cada API (esquema, host e porta, sem caminho e sem barra no final).
# O navegador nunca recebe estes endereços: ele só chama /proxy/... neste portal.
API_REGIME_REGULAR_URL=http://localhost:8080
API_SIMPLES_NACIONAL_URL=http://localhost:8082
API_DANFSE_URL=http://localhost:8081
